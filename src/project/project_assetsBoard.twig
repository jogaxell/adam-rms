<!--Sortable-->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js" integrity="sha256-KM512VNnjElC30ehFwehXjx1YCHPiQkOPmqnrWtpccM=" crossorigin="anonymous"></script>
<!-- Resolve conflict in jQuery UI tooltip with Bootstrap tooltip -->
<script>
    $.widget.bridge('uibutton', $.ui.button)
</script>
<style>
    .scrolling-head {
        display: flex;
        flex-wrap: wrap;
    }
    @media only screen and (max-width: 768px) {
        .scrolling-head {
            display: block;
        }
        .scrolling-head > div {
            width: 100%;
            max-width: 100%;
        }
    }
    #navItemQuickDispatch {
        height: 100%;
    }
    #navItemQuickDispatch button {
        background-color: transparent;
    }
    #navItemBarcodeDispatch {
        height: 100%;
    }
    #navItemBarcodeDispatch button {
        background-color: transparent;
    }
    #navItemLocationDispatch {
        height: 100%;
    }
    #navItemLocationDispatch button {
        background-color: transparent;
    }
    /* Barcode Dispatch: fills the screen on phones/handheld scanners, the log takes whatever height is left */
    #barcodeDispatchModal .modal-content {
        height: min(85vh, 720px);
    }
    #barcodeDispatchModal .modal-body {
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
    }
    #barcodeDispatchModal .barcode-dispatch-log {
        flex: 1 1 auto;
        min-height: 4rem;
        overflow-y: auto;
        border-top: 1px solid rgba(128, 128, 128, .3);
        padding-top: .25rem;
    }
    .barcode-dispatch-log-line {
        font-size: .875rem;
        line-height: 1.3;
        padding: .2rem .25rem;
        border-bottom: 1px solid rgba(128, 128, 128, .15);
        overflow-wrap: anywhere;
    }
    .barcode-dispatch-log-line:first-child {
        background-color: rgba(128, 128, 128, .1);
    }
    .barcode-dispatch-log-success i { color: #28a745; }
    .barcode-dispatch-log-warning i { color: #e0a800; }
    .barcode-dispatch-log-danger { color: #dc3545; }
    .barcode-dispatch-log-info i { color: #17a2b8; }
    #barcodeDispatchModal .barcode-dispatch-hint {
        line-height: 1.25;
    }
    @media (max-width: 575.98px) {
        #barcodeDispatchModal .modal-dialog {
            margin: 0;
            max-width: none;
            height: 100%;
        }
        #barcodeDispatchModal .modal-content {
            height: 100%;
            border: 0;
            border-radius: 0;
        }
        #barcodeDispatchModal .modal-header {
            padding: .4rem .75rem;
        }
        #barcodeDispatchModal .modal-title {
            font-size: 1.05rem;
        }
    }
</style>
<div class="card card-primary card-outline card-outline-tabs">
    <div class="card-header p-0 border-bottom-0 card-tabs">
        <ul class="nav nav-tabs" id="asset-list-tabs-tab" role="tablist">
            {% if FINANCIALS.assetsAssigned|length > 0 %}
                <li class="nav-item">
                    <a class="nav-link active assetsBoardToggle" id="asset-board-tab-thisinstance" data-toggle="pill" href="#asset-board-thisinstance" role="tab" aria-controls="asset-board-thisinstance" aria-selected="false">{{ USERDATA.instance.instances_name }}</a>
                </li>
            {% endif %}
            {% for instance in FINANCIALS.assetsAssignedSUB %}
                <li class="nav-item">
                    <a class="nav-link assetsBoardToggle" id="asset-board-tab-instance{{ instance['instance'].instances_id }}" data-toggle="pill" href="#asset-board-instance{{ instance['instance'].instances_id }}" role="tab" aria-controls="asset-board-instance{{ instance['instance'].instances_id }}" aria-selected="false">{{  instance['instance'].instances_name }} Assets</a>
                </li>
            {% endfor %}
            {% if (FINANCIALS.assetsAssigned|length > 0 or FINANCIALS.assetsAssignedSUB|length > 0) and "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions %}
                <li class="nav-item" id="navItemQuickDispatch">
                    <button type="button" class="nav-link" title="Quick Dispatch" data-toggle="modal" data-target="#quickDispatchModal">
                        <i class="fas fas fa-shipping-fast"></i>
                    </button>
                </li>
                <li class="nav-item" id="navItemBarcodeDispatch">
                    <button type="button" class="nav-link" title="Barcode Dispatch" data-toggle="modal" data-target="#barcodeDispatchModal">
                        <i class="fas fa-barcode"></i>
                    </button>
                </li>
                <li class="nav-item" id="navItemLocationDispatch">
                    <button type="button" class="nav-link" title="Location Dispatch" data-toggle="modal" data-target="#locationDispatchModal">
                        <i class="fas fa-map-marked-alt"></i>
                    </button>
                </li>
            {% endif %}
        </ul>
    </div>
    <div class="card-body p-0">
        <div class="tab-content" id="asset-board-tabs-tabContent">
            <div class="tab-pane show active p2" id="asset-board-thisinstance" role="tabpanel" aria-labelledby="asset-list-tabs-profile-tab">
                {% embed 'project/twigIncludes/assetBoard/board.twig' with {"instanceAssets": BOARDASSETS[USERDATA.instance["instances_id"]], "instanceid":USERDATA.instance["instances_id"] } %}
                {% endembed %}
            </div>
            {% for instance in FINANCIALS.assetsAssignedSUB %}
            <div class="tab-pane p2" id="asset-board-instance{{ instance['instance']['instances_id'] }}">
                {% embed 'project/twigIncludes/assetBoard/board.twig' with {"instanceAssets": BOARDASSETS[instance['instance']['instances_id']], "instanceid":instance['instance']['instances_id'] } %}
                {% endembed %}
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions %}
<div class="modal fade" id="quickDispatchModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Quick Dispatch</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <ul class="nav nav-tabs" role="tablist">
                    {% if FINANCIALS.assetsAssigned|length > 0 %}
                        <li class="nav-item">
                            <a class="nav-link active" data-toggle="pill" href="#quick-dispatch-modal-board-thisinstance" role="tab" aria-controls="quick-dispatch-modal-board-thisinstance" aria-selected="false">{{ USERDATA.instance.instances_name }}</a>
                        </li>
                    {% endif %}
                    {% for instance in FINANCIALS.assetsAssignedSUB %}
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="pill" href="#quick-dispatch-modal-board-instance{{ instance['instance'].instances_id }}" role="tab" aria-controls="quick-dispatch-modal-board-instance{{ instance['instance'].instances_id }}" aria-selected="false">{{  instance['instance'].instances_name }}</a>
                        </li>
                    {% endfor %}
                </ul>
                <div class="p-3">
                    <div class="tab-content">
                        <div class="tab-pane show active p2" id="quick-dispatch-modal-board-thisinstance" role="tabpanel" aria-labelledby="asset-list-tabs-profile-tab">
                            <p>Enter an asset's tag from {{ USERDATA.instance.instances_name }} to set its status.</p>
                            <div class="form-group">
                                <label>Set Asset Status to</label>
                                <select class="form-control assetStatusSelectorQuickDispatch" data-instanceid="{{ USERDATA.instance["instances_id"] }}">
                                    {% for status in BOARDSTATUSES[USERDATA.instance["instances_id"]] %}
                                    <option value="{{ status['assetsAssignmentsStatus_id'] }}">{{ status['assetsAssignmentsStatus_name'] }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        {% for instance in FINANCIALS.assetsAssignedSUB %}
                        <div class="tab-pane p2" id="quick-dispatch-modal-board-instance{{ instance['instance']['instances_id'] }}">
                            <p>Enter an asset's tag from {{  instance['instance'].instances_name }} tag to set its status.</p>
                            <div class="form-group">
                                <label>Set Asset Status to</label>
                                <select class="form-control assetStatusSelectorQuickDispatch" data-instanceid="{{ instance['instance']['instances_id'] }}">
                                    {% for status in BOARDSTATUSES[instance['instance']['instances_id']] %}
                                    <option value="{{ status['assetsAssignmentsStatus_id'] }}">{{ status['assetsAssignmentsStatus_name'] }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        {% endfor %}
                    </div>                
                    <div class="form-group">
                        <label>Asset Tag</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="assetTagQuickDispatch" />
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" type="button" id="goQuickDispatch">
                                    <i class="fas fa-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div id="assetTagResultQuickDispatch"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="barcodeDispatchModal" tabindex="-1" aria-labelledby="barcodeDispatchModalTitle">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="barcodeDispatchModalTitle"><i class="fas fa-barcode mr-1"></i> Barcode Dispatch</h5>
                <span class="badge badge-warning align-self-center ml-2" id="barcodeDispatchStale" style="display: none;" title="Assets were added to the project - the board reloads when you close this window">Board reloads on close</span>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-2">
                {% if FINANCIALS.assetsAssignedSUB|length > 0 %}
                <ul class="nav nav-tabs nav-tabs-sm mb-2" role="tablist">
                    {% if FINANCIALS.assetsAssigned|length > 0 %}
                        <li class="nav-item">
                            <a class="nav-link py-1 active" data-toggle="pill" href="#barcode-dispatch-modal-board-thisinstance" role="tab" aria-controls="barcode-dispatch-modal-board-thisinstance" aria-selected="true">{{ USERDATA.instance.instances_name }}</a>
                        </li>
                    {% endif %}
                    {% for instance in FINANCIALS.assetsAssignedSUB %}
                        <li class="nav-item">
                            <a class="nav-link py-1{% if FINANCIALS.assetsAssigned|length == 0 and loop.first %} active{% endif %}" data-toggle="pill" href="#barcode-dispatch-modal-board-instance{{ instance['instance'].instances_id }}" role="tab" aria-controls="barcode-dispatch-modal-board-instance{{ instance['instance'].instances_id }}" aria-selected="false">{{  instance['instance'].instances_name }}</a>
                        </li>
                    {% endfor %}
                </ul>
                {% endif %}
                <div class="form-row">
                    <div class="col-12 col-sm-6 mb-1">
                        <div class="tab-content">
                            {% if FINANCIALS.assetsAssigned|length > 0 %}
                            <div class="tab-pane show active" id="barcode-dispatch-modal-board-thisinstance" role="tabpanel">
                                <div class="input-group input-group-sm">
                                    <div class="input-group-prepend"><label class="input-group-text" for="barcodeDispatchStatus{{ USERDATA.instance["instances_id"] }}" title="Status scanned assets are set to"><i class="fas fa-tasks mr-1"></i> Status</label></div>
                                    <select class="form-control assetStatusSelectorBarcodeDispatch" id="barcodeDispatchStatus{{ USERDATA.instance["instances_id"] }}" data-instanceid="{{ USERDATA.instance["instances_id"] }}">
                                        {% for status in BOARDSTATUSES[USERDATA.instance["instances_id"]] %}
                                        <option value="{{ status['assetsAssignmentsStatus_id'] }}">{{ status['assetsAssignmentsStatus_name'] }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            {% endif %}
                            {% for instance in FINANCIALS.assetsAssignedSUB %}
                            <div class="tab-pane{% if FINANCIALS.assetsAssigned|length == 0 and loop.first %} show active{% endif %}" id="barcode-dispatch-modal-board-instance{{ instance['instance']['instances_id'] }}" role="tabpanel">
                                <div class="input-group input-group-sm">
                                    <div class="input-group-prepend"><label class="input-group-text" for="barcodeDispatchStatus{{ instance['instance']['instances_id'] }}" title="Status scanned assets are set to"><i class="fas fa-tasks mr-1"></i> Status</label></div>
                                    <select class="form-control assetStatusSelectorBarcodeDispatch" id="barcodeDispatchStatus{{ instance['instance']['instances_id'] }}" data-instanceid="{{ instance['instance']['instances_id'] }}">
                                        {% for status in BOARDSTATUSES[instance['instance']['instances_id']] %}
                                        <option value="{{ status['assetsAssignmentsStatus_id'] }}">{{ status['assetsAssignmentsStatus_name'] }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 mb-1">
                        <div class="input-group input-group-sm">
                            <div class="input-group-prepend"><label class="input-group-text" for="barcodeDispatchLocation" title="Where scanned assets are recorded - or scan a location barcode"><i class="fas fa-map-marker-alt mr-1"></i> Location</label></div>
                            <select class="form-control" id="barcodeDispatchLocation">
                                <option value="none">None - status only</option>
                                {% if project.locations_id %}
                                <option value="project">Project venue ({{ project.locations_name }})</option>
                                {% endif %}
                                <option value="storage">Each asset's storage location</option>
                                {% if barcodeDispatchLocations|length > 0 %}
                                <optgroup label="Location">
                                    {% for location in barcodeDispatchLocations %}
                                    <option value="barcode:{{ location.locationsBarcodes_id }}" data-name="{{ location.locations_name }}">{{ location.label }}</option>
                                    {% endfor %}
                                </optgroup>
                                {% endif %}
                            </select>
                        </div>
                    </div>
                </div>
                <p class="small text-muted mb-1 barcode-dispatch-hint" id="barcodeDispatchHint"></p>
                {% embed 'assets/widgets/barcodeScanner.twig' with {"scannerCallback": "dispatchBarcodeScanned", "scannerIdSuffix": "Dispatch"} %}
                {% endembed %}
                <div class="barcode-dispatch-log mt-2" id="barcodeDispatchResult" aria-live="polite">
                    <p class="text-muted small text-center my-3 barcode-dispatch-log-empty">Scanned assets will appear here.</p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="locationDispatchModal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><i class="fas fa-map-marked-alt mr-2"></i>Location Dispatch</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs" role="tablist">
                    {% if FINANCIALS.assetsAssigned|length > 0 %}
                        <li class="nav-item">
                            <a class="nav-link active location-dispatch-tab" data-toggle="pill" href="#location-dispatch-tab-thisinstance" role="tab" data-instanceid="{{ USERDATA.instance.instances_id }}">{{ USERDATA.instance.instances_name }}</a>
                        </li>
                    {% endif %}
                    {% for instance in FINANCIALS.assetsAssignedSUB %}
                        <li class="nav-item">
                            <a class="nav-link{% if FINANCIALS.assetsAssigned|length == 0 and loop.first %} active{% endif %} location-dispatch-tab" data-toggle="pill" href="#location-dispatch-tab-{{ instance.instance.instances_id }}" role="tab" data-instanceid="{{ instance.instance.instances_id }}">{{ instance.instance.instances_name }}</a>
                        </li>
                    {% endfor %}
                </ul>
                <div class="tab-content pt-3">
                    {% if FINANCIALS.assetsAssigned|length > 0 %}
                    <div class="tab-pane show active" id="location-dispatch-tab-thisinstance" role="tabpanel">
                        <div class="form-group">
                            <label>Filter by Status</label>
                            <select class="form-control locationDispatchStatusFilter">
                                <option value="">All Statuses</option>
                                {% for status in BOARDSTATUSES[USERDATA.instance.instances_id] %}
                                    <option value="{{ status.assetsAssignmentsStatus_id }}">{{ status.assetsAssignmentsStatus_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="width: 30px;"><input type="checkbox" class="locationDispatchSelectAll" title="Select all visible"></th>
                                        <th>Tag</th>
                                        <th>Asset</th>
                                        <th>Status</th>
                                        <th>Current Location</th>
                                        <th>Storage Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for status in BOARDASSETS[USERDATA.instance.instances_id] %}
                                        {% for asset in status.assets %}
                                            <tr class="location-dispatch-asset-row" data-statusid="{{ status.assetsAssignmentsStatus_id }}" data-instance="{{ USERDATA.instance.instances_id }}">
                                                <td><input type="checkbox" class="location-dispatch-asset-checkbox" data-assignment="{{ asset.assetsAssignments_id }}" data-tag="{{ asset.assets_tag }}"></td>
                                                <td><a href="{{ CONFIG.ROOTURL }}/asset.php?id={{ asset.assetTypes_id }}&asset={{ asset.assets_id }}&instance={{ USERDATA.instance.instances_id }}" target="_blank">{{ asset.assets_tag }}</a></td>
                                                <td>{{ asset.assetTypes_name }}</td>
                                                <td class="location-dispatch-status-cell">{{ status.assetsAssignmentsStatus_name }}</td>
                                                <td>
                                                    {% if asset.latestScan %}
                                                        {% if asset.latestScan.locations_name %}{{ asset.latestScan.locations_name }}
                                                        {% elseif asset.latestScan.assetTypes_name %}Inside {{ asset.latestScan.assetTypes_name }} ({{ asset.latestScan.assets_tag }})
                                                        {% elseif asset.latestScan.assetsBarcodes_customLocation %}{{ asset.latestScan.assetsBarcodes_customLocation }}
                                                        {% else %}<em class="text-muted">Unknown</em>{% endif %}
                                                    {% else %}<em class="text-muted">No scan recorded</em>{% endif %}
                                                </td>
                                                <td>
                                                    {% if asset.storage_location and asset.storage_location[0] is defined %}{{ asset.storage_location[0].locations_name }}
                                                    {% else %}<em class="text-muted">None</em>{% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    {% endif %}
                    {% for instance in FINANCIALS.assetsAssignedSUB %}
                    <div class="tab-pane{% if FINANCIALS.assetsAssigned|length == 0 and loop.first %} show active{% endif %}" id="location-dispatch-tab-{{ instance.instance.instances_id }}" role="tabpanel">
                        <div class="form-group">
                            <label>Filter by Status</label>
                            <select class="form-control locationDispatchStatusFilter">
                                <option value="">All Statuses</option>
                                {% for status in BOARDSTATUSES[instance.instance.instances_id] %}
                                    <option value="{{ status.assetsAssignmentsStatus_id }}">{{ status.assetsAssignmentsStatus_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="width: 30px;"><input type="checkbox" class="locationDispatchSelectAll" title="Select all visible"></th>
                                        <th>Tag</th>
                                        <th>Asset</th>
                                        <th>Status</th>
                                        <th>Current Location</th>
                                        <th>Storage Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for status in BOARDASSETS[instance.instance.instances_id] %}
                                        {% for asset in status.assets %}
                                            <tr class="location-dispatch-asset-row" data-statusid="{{ status.assetsAssignmentsStatus_id }}" data-instance="{{ instance.instance.instances_id }}">
                                                <td><input type="checkbox" class="location-dispatch-asset-checkbox" data-assignment="{{ asset.assetsAssignments_id }}" data-tag="{{ asset.assets_tag }}"></td>
                                                <td><a href="{{ CONFIG.ROOTURL }}/asset.php?id={{ asset.assetTypes_id }}&asset={{ asset.assets_id }}&instance={{ instance.instance.instances_id }}" target="_blank">{{ asset.assets_tag }}</a></td>
                                                <td>{{ asset.assetTypes_name }}</td>
                                                <td class="location-dispatch-status-cell">{{ status.assetsAssignmentsStatus_name }}</td>
                                                <td>
                                                    {% if asset.latestScan %}
                                                        {% if asset.latestScan.locations_name %}{{ asset.latestScan.locations_name }}
                                                        {% elseif asset.latestScan.assetTypes_name %}Inside {{ asset.latestScan.assetTypes_name }} ({{ asset.latestScan.assets_tag }})
                                                        {% elseif asset.latestScan.assetsBarcodes_customLocation %}{{ asset.latestScan.assetsBarcodes_customLocation }}
                                                        {% else %}<em class="text-muted">Unknown</em>{% endif %}
                                                    {% else %}<em class="text-muted">No scan recorded</em>{% endif %}
                                                </td>
                                                <td>
                                                    {% if asset.storage_location and asset.storage_location[0] is defined %}{{ asset.storage_location[0].locations_name }}
                                                    {% else %}<em class="text-muted">None</em>{% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <div class="mt-1 mb-3">
                    <small class="text-muted" id="locationDispatchSelectionCount">0 assets selected</small>
                </div>
                <hr>
                <div class="form-group">
                    <label>Target Location Strategy</label>
                    <div>
                        <div class="form-check mb-1" id="locationStrategyProjectGroup">
                            <input class="form-check-input" type="radio" name="locationStrategy" id="locationStrategyProject" value="project"
                                {{ project.locations_id ? '' : 'disabled' }}>
                            <label class="form-check-label" for="locationStrategyProject">
                                Project Location
                                {% if project.locations_id %}
                                    — <strong>{{ project.locations_name }}</strong>
                                {% else %}
                                    <span class="text-muted">(disabled — no venue assigned to this project)</span>
                                {% endif %}
                            </label>
                        </div>
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="radio" name="locationStrategy" id="locationStrategyStorage" value="storage" checked>
                            <label class="form-check-label" for="locationStrategyStorage">
                                Asset Storage Location <span class="text-muted">(each asset's own home location; assets with none set will be skipped)</span>
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="locationStrategy" id="locationStrategyOther" value="other">
                            <label class="form-check-label" for="locationStrategyOther">
                                Other Location
                            </label>
                        </div>
                        <div id="locationDispatchOtherLocationGroup" style="display: none;" class="ml-4">
                            <select class="form-control" id="locationDispatchOtherLocation">
                                <option value="">Select a location…</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div id="locationDispatchResult"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="locationDispatchConfirm">
                    <i class="fas fa-map-marked-alt mr-1"></i>Assign Location
                </button>
            </div>
        </div>
    </div>
</div>
{% endif %}
<script>
    const Toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000
    });

    if (localStorage.getItem("activeTab-board")) {
        $('a.assetsBoardToggle[href=\'#' + localStorage.getItem("activeTab-board") + '\']').tab('show');
    }

    {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions %}

    // Whether the user can assign assets to projects (for Supermarket Sweep)
    const canAssignAssets = {{ "PROJECTS:PROJECT_ASSETS:CREATE:ASSIGN_AND_UNASSIGN"|instancePermissions ? 'true' : 'false' }};

    // Create an array of status ids, ordered
    const assetStatusesRaw = JSON.parse('{{ BOARDSTATUSES|json_encode|raw }}');
    var assetStatuses = {};
    for (const [instanceid, instanceStatuses] of Object.entries(assetStatusesRaw)) {
        var newDir = {"orderedStatusIds": [], "allData": instanceStatuses};
        // In theory, if the statuses have been sorted by the user dragging them around then the orders will be in order and so JS will recognise them as an array. Otherwise they'll be an object (e.g. if someone has deleted a status but not dragged them around)
        if (Array.isArray(instanceStatuses)) {
            instanceStatuses.forEach((item) => {
                newDir["orderedStatusIds"].push(item["assetsAssignmentsStatus_id"]);
            });
        } else if (typeof instanceStatuses === 'object') {
            for (const [key, value] of Object.entries(instanceStatuses)) {
                newDir["orderedStatusIds"].push(value["assetsAssignmentsStatus_id"]);
            }
        }
        assetStatuses[instanceid] = newDir;
    }
    // Show/Hide relevant buttons for touchscreen control
    function drawButtons() {
        $('.assetDispatchAssetList').each(function(){
            var instance = $(this).data("instance");
            var statusid = $(this).data("statusid");
            var position = assetStatuses[instance]['orderedStatusIds'].indexOf(statusid);
            var prev = (position == 0 ? false : assetStatuses[instance]['orderedStatusIds'][position-1]);
            var next = (position == assetStatuses[instance]['orderedStatusIds'].length - 1 ? false : assetStatuses[instance]['orderedStatusIds'][position+1]);

            $(this).find(".assetDispatchAssetList-statusPrevButton").css('display', prev === false ? 'none': 'block');
            $(this).find(".assetDispatchAssetList-statusPrevButton").data('nextstatus', prev);
            $(this).find(".assetDispatchAssetList-statusNextButton").css('display', next === false ? 'none': 'block');
            $(this).find(".assetDispatchAssetList-statusNextButton").data('nextstatus', next);
        });
    }
    /**
     * Function to change the status of an asset assignment
     * @param assetsAssignments_id Id of the AssetAssignment
     * @param assetsAssignments_status new status id of the AssetAssignment
     */
    function changeStatus(assetsAssignments_id, assetsAssignments_status) {
        ajaxcall("projects/assets/setStatus.php", {"assetsAssignments_id":assetsAssignments_id, "assetsAssignments_status":assetsAssignments_status}, function (returned) {
            drawButtons();
            Toast.fire({
                type: 'success',
                title: 'Asset Status Updated'
            });
        });
    }
    // ── Barcode Dispatch ──────────────────────────────────────────────────
    // Every scanned asset gets the chosen status and, if a location is chosen, is recorded at that location.
    // Scanning a location barcode switches the location. Called by the shared barcode scanner widget, one scan at a time.
    var barcodeDispatchStorageKey = "adamrms-barcodeDispatch-{{ project.projects_id }}";
    var barcodeDispatchBoardStale = false;

    function barcodeDispatchStatusSelect() {
        return $("#barcodeDispatchModal .tab-pane.active .assetStatusSelectorBarcodeDispatch");
    }
    function barcodeDispatchSaveSettings() {
        var statuses = {};
        $(".assetStatusSelectorBarcodeDispatch").each(function () {
            statuses[$(this).data("instanceid")] = $(this).val();
        });
        try {
            localStorage.setItem(barcodeDispatchStorageKey, JSON.stringify({location: $("#barcodeDispatchLocation").val(), statuses: statuses}));
        } catch (e) {}
    }
    function barcodeDispatchRestoreSettings() {
        var settings = {};
        try {
            settings = JSON.parse(localStorage.getItem(barcodeDispatchStorageKey)) || {};
        } catch (e) {}
        $.each(settings.statuses || {}, function (instanceId, statusId) {
            var select = $(".assetStatusSelectorBarcodeDispatch[data-instanceid='" + instanceId + "']");
            if (select.find("option").filter(function () { return this.value == statusId; }).length) select.val(statusId);
        });
        var locationSelect = $("#barcodeDispatchLocation");
        if (settings.location && locationSelect.find("option").filter(function () { return this.value === settings.location; }).length) {
            locationSelect.val(settings.location);
        }
        barcodeDispatchUpdateHint();
    }
    function barcodeDispatchUpdateHint() {
        var status = barcodeDispatchStatusSelect().find("option:selected").text();
        var location = $("#barcodeDispatchLocation").val();
        var hint = $("#barcodeDispatchHint").empty().append("Scanned assets are set to ", $("<strong>").text(status));
        if (location === "none") {
            hint.append(". No location is recorded - scan a location barcode to add one.");
        } else {
            var where;
            if (location === "storage") where = "their own storage location";
            else if (location === "project") where = "the project venue";
            else where = $("#barcodeDispatchLocation option:selected").data("name");
            hint.append(" and recorded at ", $("<strong>").text(where), ". Scan a location barcode to change it.");
        }
    }
    function barcodeDispatchLog(kind, title, detail) {
        var icons = {success: "fa-check-circle", warning: "fa-exclamation-triangle", danger: "fa-times-circle", info: "fa-map-marker-alt"};
        var log = $("#barcodeDispatchResult");
        log.find(".barcode-dispatch-log-empty").remove();
        var line = $("<div>").addClass("barcode-dispatch-log-line barcode-dispatch-log-" + kind)
            .append($("<small>").addClass("text-muted float-right ml-1").text(new Date().toLocaleTimeString([], {hour: "2-digit", minute: "2-digit", second: "2-digit"})))
            .append($("<i>").addClass("fas fa-fw mr-1 " + icons[kind]))
            .append($("<strong>").text(title));
        if (detail) line.append($("<span>").text(" " + detail));
        log.prepend(line);
        log.children(".barcode-dispatch-log-line").slice(50).remove();
        log.scrollTop(0);
        if (navigator.vibrate) {
            try {
                navigator.vibrate(kind === "danger" ? [80, 60, 80] : (kind === "warning" ? [40, 60, 40] : 40));
            } catch (e) {}
        }
    }
    function barcodeDispatchRequestData(value, type) {
        var statusSelect = barcodeDispatchStatusSelect();
        var location = $("#barcodeDispatchLocation").val();
        var data = {
            text: value,
            assetsAssignments_status: statusSelect.val(),
            projects_id: {{ project.projects_id }},
            instances_id: statusSelect.data("instanceid"),
            recordScan: "location",
            scanned: "true"
        };
        if (type && type !== "UNKNOWN") data.type = type;
        if (location === "project" || location === "storage") {
            data.locationType = location;
        } else if (location && location.indexOf("barcode:") === 0) {
            data.locationType = "barcode";
            data.location = location.substring("barcode:".length);
        }
        return data;
    }
    function barcodeDispatchPost(data) {
        return $.ajax({
            url: "{{ CONFIG.ROOTURL }}/api/projects/assets/setStatusBarcode.php",
            type: "POST",
            data: data,
            cache: false,
            timeout: 20000
        });
    }
    function barcodeDispatchSucceeded(response, data, prefix) {
        var instanceId = data.instances_id;
        var assetCard = $(".assetDispatchAssetList[data-instance=" + instanceId + "] .assetDispatchAssetList-card[data-asset=" + response.assets_id + "]");
        if (assetCard.length) {
            assetCard.detach().appendTo(".assetDispatchAssetList[data-statusid=" + data.assetsAssignments_status + "][data-instance=" + instanceId + "]");
            assetCard[0].dataset.currentstatus = data.assetsAssignments_status;
            drawButtons();
            // Keep the Location Dispatch table's "Current Location" in step with what was just recorded
            if (response.location_name) {
                $(".location-dispatch-asset-checkbox[data-assignment='" + assetCard.data("assignment") + "']").closest("tr").children("td").eq(4).text(response.location_name);
            }
        }
        var detail = (prefix ? prefix + " " : "") + "→ " + response.assetsAssignmentsStatus_name;
        if (response.location_name) {
            detail += " · " + response.location_name;
            barcodeDispatchLog("success", aTag(response.assets_tag) + " " + response.assetTypes_name, detail);
        } else if (response.locationSkipped === "NOSTORAGELOCATION") {
            barcodeDispatchLog("warning", aTag(response.assets_tag) + " " + response.assetTypes_name, detail + " · no storage location set, so no location recorded");
        } else {
            barcodeDispatchLog("success", aTag(response.assets_tag) + " " + response.assetTypes_name, detail);
        }
    }
    function barcodeDispatchSetScannedLocation(location) {
        if (location.locations_archived == 1) {
            barcodeDispatchLog("danger", location.locations_name, "is archived - location not changed");
            return;
        }
        var select = $("#barcodeDispatchLocation");
        var value = "barcode:" + location.locationsBarcodes_id;
        if (!select.find("option").filter(function () { return this.value === value; }).length) {
            var group = select.children("optgroup");
            if (!group.length) group = $("<optgroup>").attr("label", "Location").appendTo(select);
            group.append($("<option>").val(value).attr("data-name", location.locations_name).text(location.locations_name));
        }
        select.val(value);
        barcodeDispatchSaveSettings();
        barcodeDispatchUpdateHint();
        barcodeDispatchLog("info", location.locations_name, "is now the location for scanned assets");
    }
    function barcodeDispatchErrorText(error, fallback) {
        if (!error) return fallback;
        if (error.code === "NOTASSIGNED") return "is not on this project - skipped";
        return error.message || fallback;
    }
    function barcodeDispatchOfferAssign(error, data, done) {
        var assetName = aTag(error.assets_tag) + " " + error.assetTypes_name;
        bootbox.confirm({
            title: "Add asset to project?",
            message: $("<div>").append($("<strong>").text(assetName), " is not on this project. Add it and set its status?").html(),
            buttons: {
                confirm: {label: "Add to project", className: "btn-success"},
                cancel: {label: "Skip", className: "btn-default"}
            },
            callback: function (confirmed) {
                if (!confirmed) {
                    barcodeDispatchLog("warning", assetName, "is not on this project - skipped");
                    done();
                    return;
                }
                $.ajax({
                    url: "{{ CONFIG.ROOTURL }}/api/projects/assets/assign.php",
                    type: "POST",
                    data: {projects_id: {{ project.projects_id }}, assets_id: error.assets_id},
                    cache: false,
                    timeout: 20000
                }).done(function (assignResult) {
                    if (!assignResult || assignResult.result !== true) {
                        barcodeDispatchLog("danger", assetName, "could not be added: " + ((assignResult && assignResult.error && assignResult.error.message) || "unknown error"));
                        done();
                        return;
                    }
                    // The new asset has no card on the board yet - reload once the user has finished scanning
                    barcodeDispatchBoardStale = true;
                    $("#barcodeDispatchStale").show();
                    barcodeDispatchPost(data).done(function (retryResult) {
                        if (retryResult.result === true) barcodeDispatchSucceeded(retryResult.response, data, "added to project");
                        else barcodeDispatchLog("warning", assetName, "added to project, but the status could not be set: " + barcodeDispatchErrorText(retryResult.error, "unknown error"));
                        done();
                    }).fail(function () {
                        barcodeDispatchLog("warning", assetName, "added to project, but the status could not be set - no connection to the server");
                        done();
                    });
                }).fail(function () {
                    barcodeDispatchLog("danger", assetName, "could not be added - no connection to the server");
                    done();
                });
            }
        });
    }
    function dispatchBarcodeScanned(value, type, done) {
        var data = barcodeDispatchRequestData(value, type);
        barcodeDispatchPost(data).done(function (result) {
            if (result.result === true) {
                barcodeDispatchSucceeded(result.response, data);
                done();
            } else if (result.error && result.error.code === "ISLOCATION") {
                barcodeDispatchSetScannedLocation(result.error.location);
                done();
            } else if (result.error && result.error.code === "NOTASSIGNED" && ('assets_id' in result.error) && canAssignAssets) {
                barcodeDispatchOfferAssign(result.error, data, done);
            } else {
                var title = (result.error && result.error.assets_tag) ? aTag(result.error.assets_tag) + " " + result.error.assetTypes_name : value;
                barcodeDispatchLog("danger", title, barcodeDispatchErrorText(result.error, "Barcode not found"));
                done();
            }
        }).fail(function () {
            barcodeDispatchLog("danger", value, "not processed - no connection to the server. Please scan it again.");
            done();
        });
    }
    {% endif %}
    $(document).ready(function () {
        {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions %}
        drawButtons();
        $(".assetDispatchAssetList").sortable({
            connectWith: "div",
            update: function( event, ui ){
                /*
                Update function is called twice, once for the old list and once for the new list.
                The lists, this, have a data attribute, status, that can be compared with each asset, ui.item[0].
                If the groupStatus is the same as the old status, this call can be ignored as this is the old list update call.
                Function call will refresh the page and sort any graphical issues.
                 */
                const groupStatus = this.dataset.statusid;
                const assetOldStatus = ui.item[0].dataset.currentstatus;
                const assetAssignment = ui.item[0].dataset.assignment;

                if (assetOldStatus !== groupStatus) {
                    changeStatus(parseInt(assetAssignment),parseInt(groupStatus));
                    ui.item[0].dataset.currentstatus = groupStatus;
                }
            }
        });

        $(".assetDispatchAssetList-statusPrevButton,.assetDispatchAssetList-statusNextButton").click(function (){
            const assetCard = $(this).parent();
            const assetAssignment = assetCard.data("assignment");
            const assetNextStatus = $(this).data("nextstatus");
            changeStatus(parseInt(assetAssignment),parseInt(assetNextStatus));
            //move card to new status
            assetCard.detach().appendTo(".assetDispatchAssetList[data-statusid=" + assetNextStatus + "][data-instance=" + assetCard.data("instance") + "]");
        });

        function doQuickDispatch() {
            const assetTag = $("#assetTagQuickDispatch").val();
            const assetStatus = $(".assetStatusSelectorQuickDispatch:visible").val();
            const instanceId = $(".assetStatusSelectorQuickDispatch:visible").data("instanceid");
            // Not using ajaxcall so we can have our own error handling for the alert boxes
            $.ajax({
                url: "{{ CONFIG.ROOTURL }}/api/projects/assets/setStatusByTag.php",
                type: "POST",
                data: {
                    text: assetTag,
                    assetsAssignments_status: assetStatus,
                    projects_id: {{ project.projects_id }},
                },
                cache: false,
                success: function(result, status, data) {
                    if (result.result === true) {
                        const assetCard = $(".assetDispatchAssetList[data-instance=" + instanceId + "] .assetDispatchAssetList-card[data-asset=" + result.response.assets_id + "]");
                        assetCard.detach().appendTo(".assetDispatchAssetList[data-statusid=" + assetStatus + "][data-instance=" + instanceId + "]");
                        drawButtons();
                    } else {
                        Toast.fire({
                            type: 'error',
                            title: assetTag + ": " + result.error.message
                        });
                        const resultDiv = $("<div>").addClass("alert alert-danger").text(assetTag + ": " + result.error.message);
                        $("#assetTagResultQuickDispatch").prepend(resultDiv);
                    }
                    $("#assetTagQuickDispatch").val("");
                    $("#assetTagQuickDispatch").focus();
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.log(jqXHR, textStatus, errorThrown);
                    console.log("Connection Error");
                    bootbox.alert('Sorry we couldn\'t connect to the internet - please check your connection', function () {
                        location.reload();
                    });
                }
            });
        }
        $("#assetTagQuickDispatch").on("keydown", function(e) {
            if (e.key !== "Enter") {
                return;
            }
            e.preventDefault();
            doQuickDispatch();
        });
        $("#goQuickDispatch").on("click", doQuickDispatch);

        // ── Barcode Dispatch settings ─────────────────────────────────────────
        barcodeDispatchRestoreSettings();
        $(".assetStatusSelectorBarcodeDispatch, #barcodeDispatchLocation").on("change", function () {
            barcodeDispatchSaveSettings();
            barcodeDispatchUpdateHint();
        });
        $("#barcodeDispatchModal").on("shown.bs.tab", function () {
            barcodeDispatchUpdateHint();
        });
        $("#barcodeDispatchModal").on("hidden.bs.modal", function () {
            if (barcodeDispatchBoardStale) location.reload();
        });

        // ── Location Dispatch ─────────────────────────────────────────────────

        // The active tab pane — the count and the dispatch action are scoped to it so
        // selections on hidden sub-business tabs never leak into the visible tab.
        function locationDispatchActivePane() {
            return $("#locationDispatchModal .tab-pane.active");
        }

        function locationDispatchUpdateCount() {
            var count = locationDispatchActivePane().find(".location-dispatch-asset-checkbox:checked").length;
            $("#locationDispatchSelectionCount").text(count + " asset" + (count === 1 ? "" : "s") + " selected");
        }

        // Status filter — scoped to the tab pane it lives in
        $(document).on("change", ".locationDispatchStatusFilter", function () {
            var tabPane = $(this).closest(".tab-pane");
            var statusId = $(this).val();
            tabPane.find(".location-dispatch-asset-row").show();
            if (statusId !== "") {
                tabPane.find(".location-dispatch-asset-row").hide();
                tabPane.find(".location-dispatch-asset-row[data-statusid='" + statusId + "']").show();
            }
            tabPane.find(".locationDispatchSelectAll").prop("checked", false);
            locationDispatchUpdateCount();
        });

        // Select all — scoped to visible rows in the tab pane it lives in
        $(document).on("change", ".locationDispatchSelectAll", function () {
            var tabPane = $(this).closest(".tab-pane");
            var checked = $(this).prop("checked");
            tabPane.find(".location-dispatch-asset-row:visible .location-dispatch-asset-checkbox").prop("checked", checked);
            locationDispatchUpdateCount();
        });

        $(document).on("change", ".location-dispatch-asset-checkbox", function () {
            locationDispatchUpdateCount();
        });

        $('input[name="locationStrategy"]').on("change", function () {
            $("#locationDispatchOtherLocationGroup").toggle($(this).val() === "other");
        });

        // Locations per instance for the "Other Location" dropdown
        var locationDispatchAllLocations = {};
        locationDispatchAllLocations["{{ USERDATA.instance.instances_id }}"] = {{ locationDispatchLocations|json_encode|raw }};
        {% for instance in FINANCIALS.assetsAssignedSUB %}
        locationDispatchAllLocations["{{ instance.instance.instances_id }}"] = {{ locationDispatchSubLocations[instance.instance.instances_id]|json_encode|raw }};
        {% endfor %}
        var locationDispatchMainInstanceId = "{{ USERDATA.instance.instances_id }}";

        function locationDispatchUpdateForInstance(instanceId) {
            var isMainInstance = (String(instanceId) === String(locationDispatchMainInstanceId));
            // "Project Location" only makes sense for the current instance's assets
            $("#locationStrategyProjectGroup").toggle(isMainInstance);
            if (!isMainInstance && $('input[name="locationStrategy"]:checked').val() === "project") {
                $('input[name="locationStrategy"][value="storage"]').prop("checked", true);
                $("#locationDispatchOtherLocationGroup").hide();
            }
            // Repopulate "Other Location" dropdown with this instance's locations
            var locations = locationDispatchAllLocations[instanceId] || [];
            var select = $("#locationDispatchOtherLocation").empty().append('<option value="">Select a location…</option>');
            locations.forEach(function (loc) {
                select.append($("<option>").val(loc.locations_id).text(loc.locations_name));
            });
        }

        // Update strategy options when the user switches tabs inside the modal
        $("#locationDispatchModal").on("shown.bs.tab", ".location-dispatch-tab", function () {
            locationDispatchUpdateForInstance($(this).data("instanceid"));
            // Recount for the newly visible tab
            locationDispatchUpdateCount();
        });

        // Sync status labels and data-statusid from the live board DOM on open
        $("#locationDispatchModal").on("show.bs.modal", function () {
            $(".location-dispatch-asset-row").each(function () {
                var row = $(this);
                var assignmentId = row.find(".location-dispatch-asset-checkbox").data("assignment");
                var instanceId = row.data("instance");
                var card = $(".assetDispatchAssetList-card[data-assignment='" + assignmentId + "']");
                if (!card.length) return;
                var currentStatusId = card.closest(".assetDispatchAssetList").data("statusid");
                row.attr("data-statusid", currentStatusId);
                var allStatuses = assetStatuses[instanceId] ? assetStatuses[instanceId].allData : [];
                var statusName = "";
                if (Array.isArray(allStatuses)) {
                    var s = allStatuses.find(function (s) { return s.assetsAssignmentsStatus_id == currentStatusId; });
                    statusName = s ? s.assetsAssignmentsStatus_name : "";
                } else {
                    for (var key in allStatuses) {
                        if (allStatuses[key].assetsAssignmentsStatus_id == currentStatusId) { statusName = allStatuses[key].assetsAssignmentsStatus_name; break; }
                    }
                }
                row.find(".location-dispatch-status-cell").text(statusName);
            });
            // Set strategy options for whichever tab is active when the modal opens
            var activeTab = $("#locationDispatchModal").find(".location-dispatch-tab.active");
            locationDispatchUpdateForInstance(activeTab.length ? activeTab.data("instanceid") : locationDispatchMainInstanceId);
        });

        $("#locationDispatchModal").on("hidden.bs.modal", function () {
            $(".locationDispatchStatusFilter").each(function () {
                $(this).val("");
                $(this).closest(".tab-pane").find(".location-dispatch-asset-row").show();
            });
            $(".locationDispatchSelectAll").prop("checked", false);
            $(".location-dispatch-asset-checkbox").prop("checked", false);
            $('input[name="locationStrategy"][value="storage"]').prop("checked", true);
            $("#locationDispatchOtherLocationGroup").hide();
            $("#locationDispatchResult").empty();
            locationDispatchUpdateCount();
        });

        $("#locationDispatchConfirm").on("click", function () {
            var strategy = $('input[name="locationStrategy"]:checked').val();
            if (!strategy) {
                Toast.fire({ type: "warning", title: "Please select a location strategy" });
                return;
            }
            if (strategy === "other" && !$("#locationDispatchOtherLocation").val()) {
                Toast.fire({ type: "warning", title: "Please select a target location" });
                return;
            }

            var selectedIds = [];
            locationDispatchActivePane().find(".location-dispatch-asset-checkbox:checked").each(function () {
                selectedIds.push($(this).data("assignment"));
            });
            if (selectedIds.length === 0) {
                Toast.fire({ type: "warning", title: "No assets selected" });
                return;
            }

            var postData = {
                projects_id: {{ project.projects_id }},
                strategy: strategy,
                "assetsAssignments_id[]": selectedIds
            };
            if (strategy === "other") {
                postData.locations_id = $("#locationDispatchOtherLocation").val();
            }

            $("#locationDispatchConfirm").prop("disabled", true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Assigning…');
            $("#locationDispatchResult").empty();

            $.ajax({
                url: "{{ CONFIG.ROOTURL }}/api/projects/assets/setLocation.php",
                type: "POST",
                data: postData,
                cache: false,
                success: function (result) {
                    $("#locationDispatchConfirm").prop("disabled", false).html('<i class="fas fa-map-marked-alt mr-1"></i>Assign Location');
                    if (!result.result) {
                        var msg = (result.error && result.error.message) ? result.error.message : "An error occurred";
                        Toast.fire({ type: "error", title: msg });
                        return;
                    }
                    var succeeded = result.response.succeeded;
                    var skipped   = result.response.skipped;

                    if (skipped.length === 0) {
                        Toast.fire({ type: "success", title: succeeded.length + " asset" + (succeeded.length === 1 ? "" : "s") + " assigned to location" });
                        $("#locationDispatchModal").modal("hide");
                    } else {
                        var summary = $("<div>").addClass("alert alert-warning mt-2");
                        summary.append($("<strong>").text(succeeded.length + " assigned, " + skipped.length + " skipped:"));
                        var list = $("<ul class='mb-0 mt-1'>");
                        skipped.forEach(function (item) {
                            list.append($("<li>").text((item.assets_tag || "Unknown") + ": " + item.reason));
                        });
                        summary.append(list);
                        $("#locationDispatchResult").html(summary);
                        if (succeeded.length > 0) {
                            Toast.fire({ type: "warning", title: succeeded.length + " assigned, " + skipped.length + " skipped — see modal for details" });
                        }
                    }
                },
                error: function () {
                    $("#locationDispatchConfirm").prop("disabled", false).html('<i class="fas fa-map-marked-alt mr-1"></i>Assign Location');
                    bootbox.alert("Sorry, we couldn't connect to the server — please check your connection");
                }
            });
        });

        {% endif %}


        $('a.assetsBoardToggle[data-toggle="pill"]').on('click', function (e) {
            localStorage.setItem("activeTab-board", e.target.getAttribute('aria-controls'));
        })
    });
</script>